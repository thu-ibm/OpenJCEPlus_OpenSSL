# OpenJCEPlus Provider Configuration with OpenSSL Backend
# This configuration file enables the OpenSSL backend instead of the default OCK backend

# Provider metadata
name = OpenJCEPlus-OpenSSL
description = OpenJCEPlus Provider with OpenSSL Backend

# Backend selector: "OCK" (default) or "OpenSSL"
backend = OpenSSL

#
# Algorithm parameter generation engines
#
Service.AlgorithmParameterGenerator.DiffieHellman = com.ibm.crypto.plus.provider.DHParameterGenerator
Service.AlgorithmParameterGenerator.alias.DiffieHellman.0 = DH
Service.AlgorithmParameterGenerator.alias.DiffieHellman.1 = 1.2.840.113549.1.3.1
Service.AlgorithmParameterGenerator.DSA = com.ibm.crypto.plus.provider.DSAParameterGenerator
Service.AlgorithmParameterGenerator.alias.DSA.0 = 1.2.840.10040.4.1
Service.AlgorithmParameterGenerator.EC = com.ibm.crypto.plus.provider.ECParameterGenerator
Service.AlgorithmParameterGenerator.GCM = com.ibm.crypto.plus.provider.GCMParameterGenerator
Service.AlgorithmParameterGenerator.CCM = com.ibm.crypto.plus.provider.CCMParameterGenerator

#
# Algorithm parameters
#
Service.AlgorithmParameters.AES = com.ibm.crypto.plus.provider.AESParameters
Service.AlgorithmParameters.ChaCha20 = com.ibm.crypto.plus.provider.ChaCha20Parameters
Service.AlgorithmParameters.ChaCha20-Poly1305 = com.ibm.crypto.plus.provider.ChaCha20Poly1305Parameters
Service.AlgorithmParameters.DESede = com.ibm.crypto.plus.provider.DESedeParameters
Service.AlgorithmParameters.alias.DESede.0 = TripleDES
Service.AlgorithmParameters.DiffieHellman = com.ibm.crypto.plus.provider.DHParameters
Service.AlgorithmParameters.alias.DiffieHellman.0 = DH
Service.AlgorithmParameters.alias.DiffieHellman.1 = 1.2.840.113549.1.3.1
Service.AlgorithmParameters.DSA = com.ibm.crypto.plus.provider.DSAParameters
Service.AlgorithmParameters.alias.DSA.0 = 1.2.840.10040.4.1
Service.AlgorithmParameters.EC = com.ibm.crypto.plus.provider.ECParameters
Service.AlgorithmParameters.GCM = com.ibm.crypto.plus.provider.GCMParameters
Service.AlgorithmParameters.CCM = com.ibm.crypto.plus.provider.CCMParameters
Service.AlgorithmParameters.OAEP = com.ibm.crypto.plus.provider.OAEPParameters
Service.AlgorithmParameters.RSAPSS = com.ibm.crypto.plus.provider.PSSParameters

#
# Cipher engines
#
Service.Cipher.AES = com.ibm.crypto.plus.provider.AESCipher$General
Service.Cipher.AES/CBC/NoPadding = com.ibm.crypto.plus.provider.AESCipher$CBC_NoPadding
Service.Cipher.AES/CBC/PKCS5Padding = com.ibm.crypto.plus.provider.AESCipher$CBC_PKCS5Padding
Service.Cipher.AES/ECB/NoPadding = com.ibm.crypto.plus.provider.AESCipher$ECB_NoPadding
Service.Cipher.AES/ECB/PKCS5Padding = com.ibm.crypto.plus.provider.AESCipher$ECB_PKCS5Padding
Service.Cipher.AES/GCM/NoPadding = com.ibm.crypto.plus.provider.AESGCMCipher
Service.Cipher.AES/CCM/NoPadding = com.ibm.crypto.plus.provider.AESCCMCipher
Service.Cipher.ChaCha20 = com.ibm.crypto.plus.provider.ChaCha20Cipher
Service.Cipher.ChaCha20-Poly1305 = com.ibm.crypto.plus.provider.ChaCha20Poly1305Cipher
Service.Cipher.DESede = com.ibm.crypto.plus.provider.DESedeCipher$General
Service.Cipher.alias.DESede.0 = TripleDES
Service.Cipher.RSA = com.ibm.crypto.plus.provider.RSACipher

#
# Key agreement
#
Service.KeyAgreement.DiffieHellman = com.ibm.crypto.plus.provider.DHKeyAgreement
Service.KeyAgreement.alias.DiffieHellman.0 = DH
Service.KeyAgreement.ECDH = com.ibm.crypto.plus.provider.ECDHKeyAgreement
Service.KeyAgreement.XDH = com.ibm.crypto.plus.provider.XDHKeyAgreement

#
# Key factories
#
Service.KeyFactory.DiffieHellman = com.ibm.crypto.plus.provider.DHKeyFactory
Service.KeyFactory.alias.DiffieHellman.0 = DH
Service.KeyFactory.DSA = com.ibm.crypto.plus.provider.DSAKeyFactory
Service.KeyFactory.EC = com.ibm.crypto.plus.provider.ECKeyFactory
Service.KeyFactory.XDH = com.ibm.crypto.plus.provider.XDHKeyFactory
Service.KeyFactory.X25519 = com.ibm.crypto.plus.provider.XDHKeyFactory$X25519
Service.KeyFactory.X448 = com.ibm.crypto.plus.provider.XDHKeyFactory$X448
Service.KeyFactory.EdDSA = com.ibm.crypto.plus.provider.EdDSAKeyFactory
Service.KeyFactory.Ed25519 = com.ibm.crypto.plus.provider.EdDSAKeyFactory$Ed25519
Service.KeyFactory.Ed448 = com.ibm.crypto.plus.provider.EdDSAKeyFactory$Ed448
Service.KeyFactory.RSA = com.ibm.crypto.plus.provider.RSAKeyFactory
Service.KeyFactory.RSASSA-PSS = com.ibm.crypto.plus.provider.RSAKeyFactory$PSS

#
# Key generators
#
Service.KeyGenerator.AES = com.ibm.crypto.plus.provider.AESKeyGenerator
Service.KeyGenerator.ChaCha20 = com.ibm.crypto.plus.provider.ChaCha20KeyGenerator
Service.KeyGenerator.DESede = com.ibm.crypto.plus.provider.DESedeKeyGenerator
Service.KeyGenerator.alias.DESede.0 = TripleDES
Service.KeyGenerator.HmacSHA1 = com.ibm.crypto.plus.provider.HmacCore$HmacSHA1$KeyGenerator
Service.KeyGenerator.HmacSHA256 = com.ibm.crypto.plus.provider.HmacCore$HmacSHA256$KeyGenerator
Service.KeyGenerator.HmacSHA384 = com.ibm.crypto.plus.provider.HmacCore$HmacSHA384$KeyGenerator
Service.KeyGenerator.HmacSHA512 = com.ibm.crypto.plus.provider.HmacCore$HmacSHA512$KeyGenerator

#
# Key pair generators
#
Service.KeyPairGenerator.DiffieHellman = com.ibm.crypto.plus.provider.DHKeyPairGenerator
Service.KeyPairGenerator.alias.DiffieHellman.0 = DH
Service.KeyPairGenerator.DSA = com.ibm.crypto.plus.provider.DSAKeyPairGenerator
Service.KeyPairGenerator.EC = com.ibm.crypto.plus.provider.ECKeyPairGenerator
Service.KeyPairGenerator.XDH = com.ibm.crypto.plus.provider.XDHKeyPairGenerator
Service.KeyPairGenerator.X25519 = com.ibm.crypto.plus.provider.XDHKeyPairGenerator$X25519
Service.KeyPairGenerator.X448 = com.ibm.crypto.plus.provider.XDHKeyPairGenerator$X448
Service.KeyPairGenerator.EdDSA = com.ibm.crypto.plus.provider.EdDSAKeyPairGenerator
Service.KeyPairGenerator.Ed25519 = com.ibm.crypto.plus.provider.EdDSAKeyPairGenerator$Ed25519
Service.KeyPairGenerator.Ed448 = com.ibm.crypto.plus.provider.EdDSAKeyPairGenerator$Ed448
Service.KeyPairGenerator.RSA = com.ibm.crypto.plus.provider.RSAKeyPairGenerator
Service.KeyPairGenerator.RSASSA-PSS = com.ibm.crypto.plus.provider.RSAKeyPairGenerator$PSS

#
# Message authentication codes
#
Service.Mac.HmacSHA1 = com.ibm.crypto.plus.provider.HmacCore$HmacSHA1
Service.Mac.HmacSHA256 = com.ibm.crypto.plus.provider.HmacCore$HmacSHA256
Service.Mac.HmacSHA384 = com.ibm.crypto.plus.provider.HmacCore$HmacSHA384
Service.Mac.HmacSHA512 = com.ibm.crypto.plus.provider.HmacCore$HmacSHA512

#
# Message digests
#
Service.MessageDigest.SHA-1 = com.ibm.crypto.plus.provider.MessageDigest$SHA1
Service.MessageDigest.alias.SHA-1.0 = SHA1
Service.MessageDigest.SHA-256 = com.ibm.crypto.plus.provider.MessageDigest$SHA256
Service.MessageDigest.alias.SHA-256.0 = SHA256
Service.MessageDigest.SHA-384 = com.ibm.crypto.plus.provider.MessageDigest$SHA384
Service.MessageDigest.alias.SHA-384.0 = SHA384
Service.MessageDigest.SHA-512 = com.ibm.crypto.plus.provider.MessageDigest$SHA512
Service.MessageDigest.alias.SHA-512.0 = SHA512

#
# Secure Random
#
Service.SecureRandom.HASHDRBG = com.ibm.crypto.plus.provider.BasicRandom
Service.SecureRandom.SHA256DRBG = com.ibm.crypto.plus.provider.SHA256Random
Service.SecureRandom.SHA512DRBG = com.ibm.crypto.plus.provider.SHA512Random

#
# Signatures
#
Service.Signature.SHA1withDSA = com.ibm.crypto.plus.provider.DSASignature$SHA1withDSA
Service.Signature.SHA256withDSA = com.ibm.crypto.plus.provider.DSASignature$SHA256withDSA
Service.Signature.SHA1withECDSA = com.ibm.crypto.plus.provider.ECDSASignature$SHA1
Service.Signature.SHA256withECDSA = com.ibm.crypto.plus.provider.ECDSASignature$SHA256
Service.Signature.SHA384withECDSA = com.ibm.crypto.plus.provider.ECDSASignature$SHA384
Service.Signature.SHA512withECDSA = com.ibm.crypto.plus.provider.ECDSASignature$SHA512
Service.Signature.Ed25519 = com.ibm.crypto.plus.provider.EdDSASignature$Ed25519
Service.Signature.Ed448 = com.ibm.crypto.plus.provider.EdDSASignature$Ed448
Service.Signature.SHA1withRSA = com.ibm.crypto.plus.provider.RSASignature$SHA1withRSA
Service.Signature.SHA256withRSA = com.ibm.crypto.plus.provider.RSASignature$SHA256withRSA
Service.Signature.SHA384withRSA = com.ibm.crypto.plus.provider.RSASignature$SHA384withRSA
Service.Signature.SHA512withRSA = com.ibm.crypto.plus.provider.RSASignature$SHA512withRSA
Service.Signature.RSASSA-PSS = com.ibm.crypto.plus.provider.RSASignature$RSAPSS